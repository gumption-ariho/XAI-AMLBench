# XAI-AMLBench environment configuration.
#
#   cp .env.example .env
#   # then edit every change_me value below before `docker compose up`
#
# docker-compose.yml reads this file directly (env_file: .env on services that need it, and
# ${VAR} interpolation everywhere else). Nothing here is read by the Python/TS code at import
# time except through those same container environment variables, so local (non-Docker) runs
# that use run_local.py or a bare .venv also need these exported, e.g. `set -a; source .env; set +a`.

# ------------------------------------------------------------------
# A. INGRESS
# ------------------------------------------------------------------
# Hostname Traefik routes on (frontend/, backend/, gnn/, xai/, grafana/ routers all key off this).
# Leave as localhost for a local run; set to a real domain for anything reachable off this machine.
PUBLIC_HOST=localhost

# Required once PUBLIC_HOST is a real domain: Traefik requests a free Let's Encrypt certificate for that
# domain on first boot (see traefik/traefik.yml) and uses this address only to email you if a renewal is
# about to fail -- it is never shown to a visitor. Must be a real inbox you check. Leave unset for a plain
# localhost run; the HTTP-01 challenge Let's Encrypt uses needs PUBLIC_HOST to actually resolve to this
# server's public IP over port 80, so this only works once DNS and port 80/443 are both pointed here.
ACME_EMAIL=you@example.com

# Kafka's EXTERNAL listener (host-reachable, port 29092) requires SASL/PLAIN auth -- see the
# apache-kafka service comment in docker-compose.yml for why. The INTERNAL listener this
# project's own producer uses (aml_synth.exporters) stays unauthenticated-but-network-isolated
# and needs no credentials here.
KAFKA_EXTERNAL_USER=change_me_kafka_user
KAFKA_EXTERNAL_PASSWORD=change_me_kafka_password
KAFKA_TOPIC_TRANSACTIONS=aml.transactions

# ------------------------------------------------------------------
# B. CORE APPLICATION (backend, frontend, node_agent) -- profile: app
# ------------------------------------------------------------------
# Off by default -- DO NOT set true outside a local reviewer demo. Skips all officer
# authentication; see backend/main.py's startup warning and get_current_officer docstring.
DEMO_LOGIN_BYPASS=false

# Login: a single predefined passkey per role (no per-officer accounts to create or manage -- see
# backend/main.py's module docstring). Whoever signs in also types their own name, which is what the audit
# trail actually records against every decision -- the passkey only proves which role they have.
ADMIN_PASSKEY=change_me_admin_passkey
ANALYST_PASSKEY=change_me_analyst_passkey

# Multi-tenant SaaS logins: one passkey per bank, so each institution gets its own walled-off console --
# logs in as role "analyst" like ANALYST_PASSKEY above, but every alert/anomaly/account it can see or touch
# is silently scoped to that bank alone (see backend/main.py's own comment above BANK_NAME_TO_PASSKEY for the
# full explanation). JSON object: {"Bank name": "passkey", ...}. Leave unset/empty if this deployment is for
# one institution only -- ADMIN_PASSKEY/ANALYST_PASSKEY above keep working exactly as before either way.
# BANK_PASSKEYS={"Equity Bank Kenya":"change_me_equity_passkey","Acme Bank":"change_me_acme_passkey"}
#
# This is the LEGACY way to add a tenant -- the owner backoffice (sign in with ADMIN_PASSKEY, then /owner)
# can now add/suspend/remove a bank at runtime too, no .env edit or restart needed, stored in the `banks`
# table instead. Both work at once: an env-configured bank here always takes priority (can't be shadowed or
# suspended by a DB row of the same name) and never needs this file touched again once it's set.
#
# A new bank can also request access itself through the public /request-access page, which only queues a
# request for the owner to approve on /owner -- it never creates a tenant on its own. Always reachable, no
# env var needed to turn it on.

# Optional email notifications: when set, a new alert emails the bank's contact address (set per-bank on the
# owner page or via a signup request). Leave SMTP_HOST unset to skip this entirely -- no email provider is
# bundled with this project, so this needs a real SMTP account (your own mail provider, SendGrid, Resend,
# SES's SMTP interface, etc.) before it does anything.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=change_me_smtp_user
# SMTP_PASSWORD=change_me_smtp_password
# SMTP_FROM=alerts@yourdomain.com

# Signs session tokens issued at login (HMAC-SHA256). If unset, backend generates a random one at startup,
# which means every restart invalidates every signed-in session (everyone has to log in again) -- set this
# so sessions survive a restart. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_SECRET=change_me_auth_token_secret
# SESSION_MAX_AGE_S=43200

# Per-person accounts (on top of the shared passkeys above): an admin invites someone from the owner page,
# which emails them a link to set their own password (requires SMTP_HOST above to actually be delivered --
# otherwise the owner page shows the link/token directly so it can still be handed over by other means).
# PUBLIC_BASE_URL is the public https:// URL of this deployment (same host as PUBLIC_HOST) -- only used to
# build that clickable link; leave unset and the invite/reset email still includes the raw token to paste in.
# PUBLIC_BASE_URL=https://yourdomain.com

# How many failed sign-in attempts (shared passkey or per-person password, counted separately per caller IP
# and per email) are allowed before a 15-minute lockout -- applies to both /login and /auth/login. Defaults
# below are a reasonable starting point; raise LOGIN_LOCKOUT_MAX_FAILURES if real testers keep getting locked
# out by typos rather than actual guessing.
# LOGIN_LOCKOUT_MAX_FAILURES=5
# LOGIN_LOCKOUT_WINDOW_S=900

# ------------------------------------------------------------------
# C. DATA STORES (used by backend, gnn-detection-api, feedback-drift-monitor, aml-synth-worker)
# ------------------------------------------------------------------
POSTGRES_USER=projectxy
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=projectxy

REDIS_PASSWORD=change_me_redis

# neo4j requires passwords of at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password
# Uncomment and change these if something else on this machine already uses 7474/7687 (e.g. another project's
# own Neo4j container) -- docker-compose.yml's neo4j-compliance-db service reads these, defaulting to the
# standard ports when unset, so most people never need to touch this.
# NEO4J_HTTP_PORT=7475
# NEO4J_BOLT_PORT=7688

IMMUDB_ADMIN_PASSWORD=change_me_immudb_password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ------------------------------------------------------------------
# D. ML / GNN DETECTION SERVICE -- profile: ml
# ------------------------------------------------------------------
# Targets gnn_aml_core/main.py checks live predictions against (see benchmark_latency.py /
# the README's benchmark tables for what these were calibrated against).
GNN_LATENCY_TARGET_MS=100
GNN_AUC_TARGET=0.87

# Optional -- defaults shown are what the code falls back to if unset; uncomment to override.
# PRED_CACHE_TTL=300
# REPORTING_THRESHOLD=10000
# GNN_WARMUP_REQUESTS=8    # real forward passes run at startup, before traffic is accepted, to absorb
                            # torch's one-time lazy-init cost at deploy time instead of on a user's first
                            # /predict call (see gnn_aml_core/main.py's module docstring). 0 disables it.
# GNN_BATCH_WINDOW_MS=8    # /predict calls landing within this window share one forward pass (accuracy-
                            # preserving request batching -- see gnn_aml_core/main.py's module docstring and
                            # check_latency_v1.py's --concurrency flag). 0 disables batching entirely.
# GNN_BATCH_MAX=64         # flush a batch early if it reaches this many requests, without waiting out the window
# GNN_PRECOMPUTE_INTERVAL_S=30   # background job keeps every known account's prediction cached (same Redis
                                 # entry /predict reads), so a real request almost never pays the full cold
                                 # inference cost -- see gnn_aml_core/main.py's module docstring. Each pass after
                                 # the first is cheap (a Redis GET per already-cached account); only newly-expired
                                 # or never-seen accounts actually re-run inference. Set to 0 to disable and
                                 # revert to the original behaviour (every account cold until a real caller asks),
                                 # e.g. on hardware where continuously scoring the whole account population isn't
                                 # an acceptable background CPU cost.
# GNN_PRECOMPUTE_PAUSE_MS=25     # pause after each account precompute actually scores (not after a cache-hit
                                 # skip), so it doesn't win the lock race against live /predict traffic during a
                                 # large first pass -- see gnn_aml_core/main.py's module docstring for the real
                                 # regression this fixed (live cold p50 went UP, not down, without this pause).
# GNN_PRECOMPUTE_CACHE_TTL=3600  # how long a BACKGROUND-PRECOMPUTED prediction stays cached -- deliberately
                                 # separate from (and much longer than) PRED_CACHE_TTL, because a full precompute
                                 # pass over a large account population can itself take longer than PRED_CACHE_TTL
                                 # (300s default), which caused a real infinite-churn bug: every pass rescored
                                 # 100% of accounts forever because entries from early in the pass had already
                                 # expired by the time the pass finished. If your own logs ever show a precompute
                                 # pass taking close to or longer than this value, raise it (the service also logs
                                 # a warning when that happens) -- see gnn_aml_core/main.py's module docstring.
# MAX_SCORE_EDGES=30000
# FEEDBACK_THRESHOLD_FALLBACK=0.5

# GNN_ADMIN_TOKEN           guards POST /admin/reload-model on gnn-detection-api (Authorization: Bearer
#                           <this value>). Shared between gnn-detection-api and feedback-drift-monitor in
#                           docker-compose.yml -- set the same value for both or the hot-reload call below
#                           gets a 401 (the retrained model still lands on disk either way; only the live
#                           swap-in is delayed to that container's next restart). Leave unset for local dev;
#                           the endpoint stays open and logs a warning on every call.
# GNN_ADMIN_TOKEN=change_me_admin_token

# FEEDBACK_AUTO_RETRAIN     the full "auto-retrain, gated before deploy" loop (see gnn_aml_core/feedback.py's
#                           module docstring): when the officer-disagreement drift trigger fires, retrain in
#                           the background on accumulated feedback, evaluate the candidate against the exact
#                           same held-out split as the model currently in production, and promote it ONLY if
#                           it measurably beats that model -- a worse model never goes live, and every
#                           promotion or rejection is appended to models/retrain_history.jsonl. OFF by default
#                           (unset/empty = report-only, matching this project's original design); read this
#                           module's docstring before turning it on, since it lets the production model change
#                           itself without a human in the loop.
# FEEDBACK_AUTO_RETRAIN=true

# FEEDBACK_MIN_IMPROVEMENT how much test AUC-ROC a retrained candidate must beat the current production
#                           model by to be promoted. 0.0 (default) means any improvement, however small,
#                           beats nothing; raise it if you want retraining noise to clear a real bar before
#                           a swap happens.
# FEEDBACK_MIN_IMPROVEMENT=0.0

# FEEDBACK_FINETUNE_LR / FEEDBACK_FINETUNE_EPOCHS / FEEDBACK_FINETUNE_PATIENCE
#                           --auto-retrain FINE-TUNES the model already in production (warm-starts from its
#                           exact saved weights) rather than training a brand-new one from scratch, so these
#                           are deliberately much smaller than train.py's from-scratch defaults (lr 0.005,
#                           epochs 150): a short, low-lr nudge is enough once a model already has good weights
#                           to start from, and it keeps the gating comparison honest (a fresh random init could
#                           lose purely to bad luck in its seed, not because the feedback didn't help).
# FEEDBACK_FINETUNE_LR=0.0005
# FEEDBACK_FINETUNE_EPOCHS=30
# FEEDBACK_FINETUNE_PATIENCE=5

# ------------------------------------------------------------------
# F. MODEL 2 -- DEEP ANOMALY DETECTOR (gnn_aml_core.anomaly) -- profile: ml
# ------------------------------------------------------------------
# A second, separate GNN: a graph autoencoder trained ONLY on accounts Model 1 currently calls normal,
# scoped away from anything Model 1 already flags (see gnn_aml_core/anomaly.py's module docstring). It never
# restarts cold -- each pass warm-starts from its own last checkpoint, so it keeps deepening its notion of
# "normal" indefinitely. Raises alerts into a SEPARATE investigation workflow (backend's /api/anomalies/*);
# only a 'confirmed_mule' resolution there ever teaches Model 1 anything -- never the routine officer
# confirm/dismiss stream on Model 1's own alerts.
# ANOMALY_INTERVAL_S=300        # how often (seconds) to re-train the autoencoder and re-score the population
# ANOMALY_SYNC_INTERVAL_S=60    # how often to check for newly-confirmed Model-2 cases to feed into Model 1
# ANOMALY_K_STD=3.0             # an account is anomalous if its reconstruction error exceeds the NORMAL
                                 # population's own median + k_std * (robust) stdev -- not a fixed global
                                 # number, since what counts as unusual depends on how hard this graph's
                                 # normal accounts are to reconstruct right now. Lower = more alerts (more
                                 # sensitive, more false positives for investigators to clear); higher = fewer,
                                 # more extreme-only alerts.

# GNN_API_URL               only needed for a local (non-Docker) run of feedback.py with --auto-retrain --
#                           docker-compose.yml already wires this to gnn-detection-api's internal address.
#                           python -m gnn_aml_core.feedback --serve-metrics --auto-retrain --gnn-api http://127.0.0.1:8001
# GNN_API_URL=http://127.0.0.1:8001

# Overrides for `python -m aml_synth.graph_generator` when run without CLI flags (e.g. the
# aml-synth-worker container's default command). Leave unset to use the generator's own
# defaults (5,000 accounts, 8 background tx/account, pattern count scaled to graph size).
# SYNTH_ACCOUNTS=5000
# SYNTH_BACKGROUND_TX=
# SYNTH_PATTERNS=
# SYNTH_OUT_DIR=data
# EXPORT_TARGETS=csv

# ------------------------------------------------------------------
# E. NARRATIVE / LLM SERVICE -- profile: llm (REQUIRES an NVIDIA GPU machine)
# ------------------------------------------------------------------
# There is no CPU/template stand-in service in this deployment -- without the llm profile running on a GPU
# machine, "why was this flagged" narrative generation is simply unavailable (the backend's
# /alerts/{id}/narrative route returns a 502) rather than silently served by something that only looks like a
# real model's explanation. LLM_BACKEND=vllm is the only setting this deployment runs with; leave it as-is.
LLM_BACKEND=vllm
LLM_MODEL=casperhansen/llama-3-8b-instruct-awq
LLM_QUANT=awq
LLM_MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.85

# Required only if LLM_MODEL is a gated/private Hugging Face model.
HF_TOKEN=change_me_huggingface_token
