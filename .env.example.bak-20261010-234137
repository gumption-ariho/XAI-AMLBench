# XAI-AMLBench environment configuration.
#
#   cp .env.example .env
#   # then edit every change_me value below before `docker compose up`
#
# docker-compose.yml reads this file directly (env_file: .env on services that need it, and
# ${VAR} interpolation everywhere else). Nothing here is read by the Python/TS code at import
# time except through those same container environment variables, so local (non-Docker) runs
# that use run_local.py or a bare .venv also need these exported, e.g. `set -a; source .env; set +a`.

# ------------------------------------------------------------------
# A. INGRESS
# ------------------------------------------------------------------
# Hostname Traefik routes on (frontend/, backend/, gnn/, xai/, grafana/ routers all key off this).
# Leave as localhost for a local run; set to a real domain for anything reachable off this machine.
PUBLIC_HOST=localhost

# Kafka's EXTERNAL listener (host-reachable, port 29092) requires SASL/PLAIN auth -- see the
# apache-kafka service comment in docker-compose.yml for why. The INTERNAL listener this
# project's own producer uses (aml_synth.exporters) stays unauthenticated-but-network-isolated
# and needs no credentials here.
KAFKA_EXTERNAL_USER=change_me_kafka_user
KAFKA_EXTERNAL_PASSWORD=change_me_kafka_password
KAFKA_TOPIC_TRANSACTIONS=aml.transactions

# ------------------------------------------------------------------
# B. CORE APPLICATION (backend, frontend, node_agent) -- profile: app
# ------------------------------------------------------------------
# Off by default -- DO NOT set true outside a local reviewer demo. Skips all officer
# authentication; see backend/main.py's startup warning and get_current_officer docstring.
DEMO_LOGIN_BYPASS=false

# ------------------------------------------------------------------
# C. DATA STORES (used by backend, gnn-detection-api, feedback-drift-monitor, aml-synth-worker)
# ------------------------------------------------------------------
POSTGRES_USER=projectxy
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=projectxy

REDIS_PASSWORD=change_me_redis

# neo4j requires passwords of at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

IMMUDB_ADMIN_PASSWORD=change_me_immudb_password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ------------------------------------------------------------------
# D. ML / GNN DETECTION SERVICE -- profile: ml
# ------------------------------------------------------------------
# Targets gnn_aml_core/main.py checks live predictions against (see benchmark_latency.py /
# the README's benchmark tables for what these were calibrated against).
GNN_LATENCY_TARGET_MS=100
GNN_AUC_TARGET=0.87

# Optional -- defaults shown are what the code falls back to if unset; uncomment to override.
# PRED_CACHE_TTL=300
# REPORTING_THRESHOLD=10000
# GNN_WARMUP_REQUESTS=8    # real forward passes run at startup, before traffic is accepted, to absorb
                            # torch's one-time lazy-init cost at deploy time instead of on a user's first
                            # /predict call (see gnn_aml_core/main.py's module docstring). 0 disables it.
# MAX_SCORE_EDGES=30000
# FEEDBACK_THRESHOLD_FALLBACK=0.5

# Overrides for `python -m aml_synth.graph_generator` when run without CLI flags (e.g. the
# aml-synth-worker container's default command). Leave unset to use the generator's own
# defaults (5,000 accounts, 8 background tx/account, pattern count scaled to graph size).
# SYNTH_ACCOUNTS=5000
# SYNTH_BACKGROUND_TX=
# SYNTH_PATTERNS=
# SYNTH_OUT_DIR=data
# EXPORT_TARGETS=csv

# ------------------------------------------------------------------
# E. NARRATIVE / LLM SERVICE -- profile: llm (GPU required; use xai-narrative-lite instead
#    to run the "app" profile on CPU with template narratives -- do not run both together)
# ------------------------------------------------------------------
# "template" runs xai-narrative-api without a GPU/LLM at all (matches xai-narrative-lite's
# behaviour); "vllm" is the real in-process vLLM backend and needs an NVIDIA GPU.
LLM_BACKEND=vllm
LLM_MODEL=casperhansen/llama-3-8b-instruct-awq
LLM_QUANT=awq
LLM_MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.85

# Required only if LLM_MODEL is a gated/private Hugging Face model.
HF_TOKEN=change_me_huggingface_token
