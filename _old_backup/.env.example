# ===== Copy to .env and change every "change_me" value =====
COMPOSE_PROJECT_NAME=xai-amlbench
PUBLIC_HOST=localhost

# --- Postgres (container 9) ---
POSTGRES_USER=projectxy
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=projectxy

# --- Redis feature cache (container 10) ---
REDIS_PASSWORD=change_me_redis

# --- Neo4j (container 11) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# --- immudb audit ledger (container 12) ---
IMMUDB_ADMIN_PASSWORD=change_me_immudb

# --- Grafana (container 14) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- Kafka topics used by aml_synth / gnn_aml_core ---
KAFKA_TOPIC_TRANSACTIONS=aml.transactions
KAFKA_TOPIC_ALERTS=aml.alerts

# --- LLM (container 8) ---
# Quantized Llama-3-8B-Instruct. Verify the repo id and license access on Hugging Face.
LLM_MODEL=casperhansen/llama-3-8b-instruct-awq
HF_TOKEN=
LLM_MAX_MODEL_LEN=4096

# --- Model targets from the client report ---
GNN_LATENCY_TARGET_MS=100
GNN_AUC_TARGET=0.87

# --- LLM runtime ---
# 'vllm' needs an NVIDIA GPU. Use 'template' to run without one (deterministic template narratives).
LLM_BACKEND=vllm
LLM_QUANT=awq
