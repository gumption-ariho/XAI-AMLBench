@api.get("/health")
def health():
    with db() as conn:
        conn.execute("SELECT 1")
    return {"status": "ok"}


@api.post("/login")
def login(req: LoginRequest):
    """The only unauthenticated route besides /health. Checks the submitted passkey against the two
    predefined, shared role passkeys (ADMIN_PASSKEY / ANALYST_PASSKEY) -- there is no per-person credential to
    issue or revoke here, by design. The name is NOT verified against anything (there's nothing to verify it
    against -- that's the tradeoff of a shared passkey instead of per-officer accounts), but it IS what gets
    signed into the session token and used for every action this person takes afterward, so the audit trail
    still reflects a specific person's name on every decision, not just 'an analyst'."""
    name = req.name.strip()
    if not name:
        raise HTTPException(400, "name is required")
    if ADMIN_PASSKEY and req.passkey == ADMIN_PASSKEY:
        role = "admin"
    elif ANALYST_PASSKEY and req.passkey == ANALYST_PASSKEY:
        role = "analyst"
    else:
        raise HTTPException(401, "invalid passkey")
    token = issue_session_token(name, role)
    audit("login", {"name": name, "role": role})
    return {"token": token, "name": name, "role": role}


