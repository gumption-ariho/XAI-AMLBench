# XAI-AMLBench -- 14-container stack
#
# Profiles (so you don't have to run everything at once):
#   (none)  -> infra: traefik, kafka, postgres, redis, neo4j, immudb
#   app     -> frontend, backend, node_agent           (ProjectXY legacy)
#   ml      -> aml-synth-worker, gnn-detection-api
#   llm     -> xai-narrative-api                       (LLM narratives, needs NVIDIA GPU)
#   (the app profile already includes xai-narrative-lite: template narratives on CPU. Do not run it together with llm.)
#   obs     -> prometheus-metrics, grafana-dashboard
#
# Examples:
#   docker compose up -d                              # infra only
#   docker compose --profile ml up -d --build         # infra + ML services
#   docker compose --profile app --profile ml --profile obs up -d
#
# NOTE: image tags below are sensible defaults. If you already pulled different
# tags, change them here so Docker uses your cached layers.

name: xai-amlbench

networks:
  xai-net:
    driver: bridge

volumes:
  pg-data:
  redis-data:
  neo4j-data:
  neo4j-logs:
  immudb-data:
  prometheus-data:
  grafana-data:
  hf-cache:

services:
  # ------------------------------------------------------------------
  # A. INGRESS & EVENT STREAMING
  # ------------------------------------------------------------------
  traefik-edge-router:            # Container 1
    image: traefik:v3                 # v3.1 cannot talk to Docker Engine 29+ (API 1.24 rejected); current v3 negotiates the API version
    restart: unless-stopped
    command: ["--configFile=/etc/traefik/traefik.yml"]
    environment:
      DOCKER_API_VERSION: "1.44"      # Docker Engine 29+ refuses the old API version Traefik v3.1 uses; without this Traefik finds no containers
    ports:
      - "80:80"
      - "127.0.0.1:8081:8081"     # Traefik dashboard (dev only) -- localhost-only, matching the "dev only"
                                  # comment's own intent. Was previously bound to all interfaces with no
                                  # authentication at all, a real finding from a security hygiene pass: this
                                  # dashboard can disclose internal routing/service topology, and shipping it
                                  # reachable from the network by default is exactly the kind of thing that
                                  # should never happen just because nobody set an explicit binding.
    volumes:
      - ./traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [xai-net]

  apache-kafka:                   # Container 2 (single-node KRaft, no ZooKeeper)
    image: apache/kafka:3.9.0
    restart: unless-stopped
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: INTERNAL://:9092,EXTERNAL://:29092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: INTERNAL://apache-kafka:9092,EXTERNAL://localhost:29092
      # EXTERNAL (host/network-reachable, port 29092) requires SASL/PLAIN authentication -- a real finding
      # from a security hygiene pass: this was unauthenticated PLAINTEXT, letting anyone who could reach the
      # port read or inject fake transactions/alerts. INTERNAL stays PLAINTEXT deliberately: it is only
      # reachable from within the trusted Docker network, and this project's own producer (aml_synth.exporters,
      # default bootstrap apache-kafka:9092) already connects via INTERNAL -- confirmed before making this
      # change, so this fix needs zero code changes anywhere in this project, only external/host-network
      # access now needs a password. SASL_PLAINTEXT (not SASL_SSL): authentication without encryption-in-
      # transit on this one listener -- real TLS certificate provisioning is a separate, larger piece of work,
      # not attempted here; this closes the "anyone can connect with no credential at all" gap specifically.
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,EXTERNAL:SASL_PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_SASL_ENABLED_MECHANISMS: PLAIN
      KAFKA_LISTENER_NAME_EXTERNAL_SASL_ENABLED_MECHANISMS: PLAIN
      KAFKA_LISTENER_NAME_EXTERNAL_PLAIN_SASL_JAAS_CONFIG: >-
        org.apache.kafka.common.security.plain.PlainLoginModule required
        username="${KAFKA_EXTERNAL_USER}"
        password="${KAFKA_EXTERNAL_PASSWORD}"
        user_${KAFKA_EXTERNAL_USER}="${KAFKA_EXTERNAL_PASSWORD}";
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@apache-kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_NUM_PARTITIONS: 3
    ports:
      - "29092:29092"             # host access for local scripts
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 >/dev/null 2>&1"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 20s
    networks: [xai-net]

  # ------------------------------------------------------------------
  # B. CORE APPLICATION (ProjectXY legacy) -- profile: app
  # ------------------------------------------------------------------
  frontend:                       # Container 3 (Next.js)
    profiles: [app]
    build: ./frontend
    restart: unless-stopped
    environment:
      NEXT_PUBLIC_API_BASE: /api
    depends_on: [backend]
    labels:
      - traefik.enable=true
      - traefik.http.routers.frontend.rule=Host(`${PUBLIC_HOST}`)
      - traefik.http.routers.frontend.entrypoints=web
      - traefik.http.routers.frontend.priority=1
      - traefik.http.services.frontend.loadbalancer.server.port=3000
    ports:
      - "3000:3000"
    networks: [xai-net]

  backend:                        # Container 4
    profiles: [app]
    build: ./backend
    restart: unless-stopped
    env_file: .env
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}
      GNN_API_URL: http://gnn-detection-api:8000
      # Shared secret with gnn-detection-api below -- lets the backend's new POST /intake/ingest route call
      # that service's admin-only POST /admin/ingest-live (the Intake tab's real-transaction ingestion path).
      # Must match GNN_ADMIN_TOKEN set on gnn-detection-api, or that call gets a 401.
      GNN_ADMIN_TOKEN: ${GNN_ADMIN_TOKEN:-}
      XAI_API_URL: http://xai-narrative-api:8000
      IMMUDB_HOST: immudb-audit-ledger
      IMMUDB_PORT: 3322
      # Off by default. Setting this to "true" in .env skips all officer authentication for a reviewer demo --
      # see backend/main.py's own loud startup warning and get_current_officer docstring. Remove it from .env
      # and restart this service to restore real per-officer login.
      DEMO_LOGIN_BYPASS: ${DEMO_LOGIN_BYPASS:-false}
    depends_on:
      database: { condition: service_healthy }
    labels:
      - traefik.enable=true
      - traefik.http.routers.backend.rule=Host(`${PUBLIC_HOST}`) && PathPrefix(`/api`)
      - traefik.http.routers.backend.entrypoints=web
      - traefik.http.routers.backend.priority=10
      - traefik.http.services.backend.loadbalancer.server.port=8000   # adjust to ProjectXY backend port
    networks: [xai-net]

  node_agent:                     # Container 5
    profiles: [app]
    build: ./node_agent
    restart: unless-stopped
    env_file: .env
    depends_on: [backend]
    networks: [xai-net]

  # ------------------------------------------------------------------
  # C. INTELLIGENCE & PROCESSING -- profiles: ml, llm
  # ------------------------------------------------------------------
  aml-synth-worker:               # Container 6
    profiles: [ml]
    build:
      context: .
      dockerfile: aml_synth/Dockerfile
    restart: "no"                 # batch worker: run on demand
    environment:
      KAFKA_BOOTSTRAP: apache-kafka:9092
      KAFKA_TOPIC_TRANSACTIONS: ${KAFKA_TOPIC_TRANSACTIONS}
      NEO4J_URI: bolt://neo4j-compliance-db:7687
      NEO4J_USER: ${NEO4J_USER}
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
    depends_on:
      apache-kafka: { condition: service_healthy }
      # neo4j-compliance-db deliberately NOT a hard dependency here either, for the same reason as
      # gnn-detection-api above: Neo4j export is OPTIONAL, controlled entirely by this worker's own --to flag
      # (--to csv,kafka,neo4j vs --to csv alone) -- a run that never asked for Neo4j export should not be
      # blocked by it being unavailable. aml_synth/exporters.py's own export_neo4j already retries on its own
      # (confirmed: up to 15 attempts) if Neo4j genuinely isn't ready yet when neo4j export IS requested.
    volumes:
      - ./data:/app/data
    networks: [xai-net]

  gnn-detection-api:              # Container 7
    profiles: [ml]
    build:
      context: .
      dockerfile: gnn_aml_core/Dockerfile
    restart: unless-stopped
    environment:
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis-feature-cache:6379/0
      NEO4J_URI: bolt://neo4j-compliance-db:7687
      NEO4J_USER: ${NEO4J_USER}
      NEO4J_PASSWORD: ${NEO4J_PASSWORD}
      KAFKA_BOOTSTRAP: apache-kafka:9092
      IMMUDB_HOST: immudb-audit-ledger
      IMMUDB_PORT: 3322
      IMMUDB_ADMIN_PASSWORD: ${IMMUDB_ADMIN_PASSWORD}
      MODEL_DIR: /app/models
      GNN_LATENCY_TARGET_MS: ${GNN_LATENCY_TARGET_MS}
      GNN_AUC_TARGET: ${GNN_AUC_TARGET}
      # Shared secret with feedback-drift-monitor below -- guards POST /admin/reload-model (see
      # gnn_aml_core/main.py's module docstring). Empty/unset leaves the endpoint open and logs a
      # warning on every call; fine for this local stack, not for anything reachable off one machine.
      GNN_ADMIN_TOKEN: ${GNN_ADMIN_TOKEN:-}
    depends_on:
      redis-feature-cache: { condition: service_healthy }
      # neo4j-compliance-db deliberately NOT a dependency here: a real architectural flaw, found on a real run
      # (a Neo4j startup failure took the entire detection API down with it, blocking every scan and explain
      # request). gnn_aml_core/main.py has zero references to Neo4j anywhere -- confirmed by direct search --
      # it is used purely for the separate, optional human-investigation/visualization feature
      # (aml_synth.exporters.export_neo4j + Neo4j Browser), never for scoring or explaining an account. The
      # core detection pipeline's availability should never be hostage to an unrelated database's health.
    volumes:
      - ./models:/app/models
      - ./data:/app/data
    labels:
      - traefik.enable=true
      - traefik.http.routers.gnn.rule=Host(`${PUBLIC_HOST}`) && PathPrefix(`/gnn`)
      - traefik.http.routers.gnn.entrypoints=web
      - traefik.http.routers.gnn.middlewares=gnn-strip
      - traefik.http.middlewares.gnn-strip.stripprefix.prefixes=/gnn
      - traefik.http.services.gnn.loadbalancer.server.port=8000
    # Uncomment for GPU inference:
    # deploy:
    #   resources:
    #     reservations:
    #       devices: [{ driver: nvidia, count: 1, capabilities: [gpu] }]
    networks: [xai-net]

  feedback-drift-monitor:         # closes a real gap: the officer-disagreement drift signal was previously
                                  # only ever visible in gnn_aml_core.feedback's own CLI output when someone
                                  # happened to run it manually. Reuses gnn-detection-api's own image unchanged
                                  # (same codebase, same dependencies already installed) with a different
                                  # command, rather than building a whole new image just to run one more module
                                  # from the same package.
    profiles: [ml]
    build:
      context: .
      dockerfile: gnn_aml_core/Dockerfile
    command: ["python", "-m", "gnn_aml_core.feedback", "--serve-metrics", "--metrics-port", "9201"]
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}
      # Auto-retrain, gated before deploy -- see gnn_aml_core/feedback.py's module docstring. Off by
      # default (empty string is falsy in --auto-retrain's env-var check): a drift trigger will only
      # report, not retrain, until you explicitly set FEEDBACK_AUTO_RETRAIN=true in .env. When it IS on,
      # GNN_API_URL/GNN_ADMIN_TOKEN are what let a promoted model reach gnn-detection-api's
      # /admin/reload-model without restarting that container; GNN_ADMIN_TOKEN here must match the one
      # set on gnn-detection-api above, or the hot-reload call gets a 401 (the new checkpoint is still
      # safely written to disk either way -- see the module docstring).
      FEEDBACK_AUTO_RETRAIN: ${FEEDBACK_AUTO_RETRAIN:-}
      FEEDBACK_MIN_IMPROVEMENT: ${FEEDBACK_MIN_IMPROVEMENT:-0.0}
      GNN_API_URL: http://gnn-detection-api:8000
      GNN_ADMIN_TOKEN: ${GNN_ADMIN_TOKEN:-}
    depends_on:
      database: { condition: service_healthy }
    volumes:
      # Needed only for --auto-retrain: retrain_and_maybe_promote() reads graph.pt/gnn_model.pt from here
      # and, on promotion, backs up the old checkpoint and writes the new one here too -- the SAME path
      # gnn-detection-api's own MODEL_DIR mounts, so a promoted model is visible to that container (via
      # live reload, or on its next restart) without any extra copy step.
      - ./models:/app/models
    networks: [xai-net]

  live-feed-consumer:              # Connect tab's Option 2: the live transaction feed. Consumes
                                   # KAFKA_TOPIC_TRANSACTIONS and turns it into real, live accounts via
                                   # gnn-detection-api's own POST /admin/ingest-live -- the exact same
                                   # endpoint the Intake tab's paste-a-document path (Option 1) already uses,
                                   # see gnn_aml_core/kafka_ingest.py's module docstring. Reuses
                                   # gnn-detection-api's own image (same codebase already installed); does
                                   # NOT mount ./models -- it never writes graph.pt/gnn_model.pt itself, only
                                   # calls the HTTP endpoint that does.
    profiles: [ml]
    build:
      context: .
      dockerfile: gnn_aml_core/Dockerfile
    command: ["python", "-m", "gnn_aml_core.kafka_ingest"]
    restart: unless-stopped
    environment:
      KAFKA_BOOTSTRAP: apache-kafka:9092
      KAFKA_TOPIC_TRANSACTIONS: ${KAFKA_TOPIC_TRANSACTIONS}
      GNN_API_URL: http://gnn-detection-api:8000
      # Must match GNN_ADMIN_TOKEN set on gnn-detection-api above, or every batch gets a 401 (logged, not
      # fatal -- see gnn_aml_core/kafka_ingest.py's _ingest_batch()/flush()).
      GNN_ADMIN_TOKEN: ${GNN_ADMIN_TOKEN:-}
      LIVE_FEED_BATCH_SIZE: ${LIVE_FEED_BATCH_SIZE:-25}
      LIVE_FEED_MAX_WAIT_SECONDS: ${LIVE_FEED_MAX_WAIT_SECONDS:-5}
    depends_on:
      apache-kafka: { condition: service_healthy }
    networks: [xai-net]

  anomaly-detector:                # Model 2: the deep, continuously-learning graph autoencoder -- see
                                   # gnn_aml_core/anomaly.py's module docstring for why this is a deliberately
                                   # SEPARATE model from gnn-detection-api (Model 1), not a variant of it.
                                   # Reuses gnn-detection-api's own image (same codebase already installed).
    profiles: [ml]
    build:
      context: .
      dockerfile: gnn_aml_core/Dockerfile
    command: ["python", "-m", "gnn_aml_core.anomaly", "--serve-metrics", "--metrics-port", "9202"]
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}
      GNN_API_URL: http://gnn-detection-api:8000
      GNN_ADMIN_TOKEN: ${GNN_ADMIN_TOKEN:-}
      ANOMALY_INTERVAL_S: ${ANOMALY_INTERVAL_S:-300}
      ANOMALY_SYNC_INTERVAL_S: ${ANOMALY_SYNC_INTERVAL_S:-60}
      ANOMALY_K_STD: ${ANOMALY_K_STD:-3.0}
      FEEDBACK_MIN_IMPROVEMENT: ${FEEDBACK_MIN_IMPROVEMENT:-0.0}
      FEEDBACK_FINETUNE_LR: ${FEEDBACK_FINETUNE_LR:-0.0005}
      FEEDBACK_FINETUNE_EPOCHS: ${FEEDBACK_FINETUNE_EPOCHS:-30}
      FEEDBACK_FINETUNE_PATIENCE: ${FEEDBACK_FINETUNE_PATIENCE:-5}
    depends_on:
      database: { condition: service_healthy }
      gnn-detection-api: { condition: service_started }
    volumes:
      # graph.pt/gnn_model.pt to read from (same as feedback-drift-monitor above), plus its own
      # anomaly_autoencoder.pt checkpoint, which it warm-starts from on every pass -- never reset to random
      # weights once it exists, which is the whole point of "never stops learning."
      - ./models:/app/models
      - ./data:/app/data
    networks: [xai-net]

  xai-narrative-api:              # Container 8 (FastAPI + in-process vLLM)
    profiles: [llm]
    build:
      context: .
      dockerfile: xai_explainer/Dockerfile   # FROM vllm/vllm-openai (pin VLLM_TAG build-arg to your pulled tag)
    restart: unless-stopped
    environment:
      LLM_BACKEND: ${LLM_BACKEND:-vllm}          # set to 'template' to run without a GPU
      LLM_MODEL: ${LLM_MODEL}
      LLM_QUANT: ${LLM_QUANT:-awq}
      LLM_MAX_MODEL_LEN: ${LLM_MAX_MODEL_LEN}
      HUGGING_FACE_HUB_TOKEN: ${HF_TOKEN}
      GNN_API_URL: http://gnn-detection-api:8000
      IMMUDB_HOST: immudb-audit-ledger
      IMMUDB_PORT: 3322
      IMMUDB_ADMIN_PASSWORD: ${IMMUDB_ADMIN_PASSWORD}
    volumes:
      - hf-cache:/root/.cache/huggingface
    ipc: host
    # No NVIDIA GPU? delete this deploy block and set LLM_BACKEND=template in .env
    deploy:
      resources:
        reservations:
          devices: [{ driver: nvidia, count: 1, capabilities: [gpu] }]
    labels:
      - traefik.enable=true
      - traefik.http.routers.xai.rule=Host(`${PUBLIC_HOST}`) && PathPrefix(`/xai`)
      - traefik.http.routers.xai.entrypoints=web
      - traefik.http.routers.xai.middlewares=xai-strip
      - traefik.http.middlewares.xai-strip.stripprefix.prefixes=/xai
      - traefik.http.services.xai.loadbalancer.server.port=8000
    networks: [xai-net]

  xai-narrative-lite:             # CPU-only narrative service (profile app): validated template narratives, no GPU needed
    profiles: [app]
    build:
      context: .
      dockerfile: xai_explainer/Dockerfile.lite
    restart: unless-stopped
    environment:
      LLM_BACKEND: template
      GNN_API_URL: http://gnn-detection-api:8000
      IMMUDB_HOST: immudb-audit-ledger
      IMMUDB_PORT: 3322
      IMMUDB_ADMIN_PASSWORD: ${IMMUDB_ADMIN_PASSWORD}
    labels:
      - traefik.enable=true
      - traefik.http.routers.xai-lite.rule=Host(`${PUBLIC_HOST}`) && PathPrefix(`/xai`)
      - traefik.http.routers.xai-lite.entrypoints=web
      - traefik.http.routers.xai-lite.middlewares=xai-lite-strip
      - traefik.http.middlewares.xai-lite-strip.stripprefix.prefixes=/xai
      - traefik.http.services.xai-lite.loadbalancer.server.port=8000
    networks:
      xai-net:
        aliases: [xai-narrative-api]     # the backend calls http://xai-narrative-api:8000 - this service answers to that name

  # ------------------------------------------------------------------
  # D. CACHING & SPECIALIZED STORAGE
  # ------------------------------------------------------------------
  database:                       # Container 9 (Postgres)
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - pg-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks: [xai-net]

  redis-feature-cache:            # Container 10
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--requirepass", "${REDIS_PASSWORD}", "--appendonly", "yes"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a $${REDIS_PASSWORD} ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 10
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD}
    networks: [xai-net]

  neo4j-compliance-db:            # Container 11
    image: neo4j:5-community
    restart: unless-stopped
    environment:
      NEO4J_AUTH: ${NEO4J_USER}/${NEO4J_PASSWORD}
      NEO4J_server_memory_heap_initial__size: 512m
      NEO4J_server_memory_heap_max__size: 1G
      NEO4J_server_memory_pagecache_size: 512m
    ports:
      - "${NEO4J_HTTP_PORT:-7474}:7474"   # Neo4j Browser (officers investigate here) -- override in .env
      - "${NEO4J_BOLT_PORT:-7687}:7687"   # Bolt -- override in .env (e.g. another local Neo4j already using 7474/7687)
    volumes:
      - neo4j-data:/data
      - neo4j-logs:/logs
    healthcheck:
      test: ["CMD-SHELL", "cypher-shell -u ${NEO4J_USER} -p ${NEO4J_PASSWORD} 'RETURN 1' >/dev/null 2>&1"]
      interval: 15s
      timeout: 10s
      retries: 12
      start_period: 30s
    networks: [xai-net]

  immudb-audit-ledger:            # Container 12
    image: codenotary/immudb:latest
    restart: unless-stopped
    environment:
      IMMUDB_ADMIN_PASSWORD: ${IMMUDB_ADMIN_PASSWORD}
      IMMUDB_METRICS_SERVER: "true"   # exposes :9497/metrics for Prometheus
    ports:
      - "8080:8080"               # immudb web console
    volumes:
      - immudb-data:/var/lib/immudb
    networks: [xai-net]

  # ------------------------------------------------------------------
  # E. OBSERVABILITY -- profile: obs
  # ------------------------------------------------------------------
  prometheus-metrics:             # Container 13
    profiles: [obs]
    image: prom/prometheus:latest
    restart: unless-stopped
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    networks: [xai-net]

  grafana-dashboard:              # Container 14
    profiles: [obs]
    image: grafana/grafana:latest
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD}
      GF_SERVER_ROOT_URL: http://${PUBLIC_HOST}/grafana/
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on: [prometheus-metrics]
    labels:
      - traefik.enable=true
      - traefik.http.routers.grafana.rule=Host(`${PUBLIC_HOST}`) && PathPrefix(`/grafana`)
      - traefik.http.routers.grafana.entrypoints=web
      - traefik.http.services.grafana.loadbalancer.server.port=3000
    networks: [xai-net]
